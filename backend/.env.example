# =============================================================================
# 知识图谱驱动的个性化自适应学习系统 后端环境变量示例
# backend/adaptive_edu_api/settings.py 默认从 backend/.env 读取配置
# =============================================================================

# -----------------------------------------------------------------------------
# Django基础配置
# -----------------------------------------------------------------------------
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=edu.qintsg.xyz,edu.qintsg.cn,47.103.44.104,106.14.209.7,127.0.0.1,localhost
USE_X_FORWARDED_HOST=True
CSRF_TRUSTED_ORIGINS=https://edu.qintsg.xyz,http://edu.qintsg.xyz,https://edu.qintsg.cn,http://edu.qintsg.cn

# -----------------------------------------------------------------------------
# PostgreSQL数据库配置
# -----------------------------------------------------------------------------
DB_NAME=adaptive_edu
DB_USER=adaptive
DB_PASSWORD=adaptive123
DB_HOST=127.0.0.1
DB_PORT=5432

# -----------------------------------------------------------------------------
# Neo4j图数据库配置（可选，用于知识图谱存储）
# 如果不配置Neo4j，系统会自动回退到PostgreSQL进行图查询
# -----------------------------------------------------------------------------
NEO4J_BOLT_URL=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# -----------------------------------------------------------------------------
# GraphRAG 混合检索配置
# - hash：默认离线向量器，无需下载模型，适合测试与演示
# - sentence_transformer：本地语义向量器，推荐正式环境启用
# -----------------------------------------------------------------------------
GRAPHRAG_EMBEDDER_PROVIDER=hash
GRAPHRAG_SENTENCE_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
GRAPHRAG_VECTOR_DIMENSION=256
GRAPHRAG_QDRANT_PATH=runtime_logs/rag/qdrant

# -----------------------------------------------------------------------------
# 学习资源 MCP 配置（自研内部资源 MCP + Tavily）
# -----------------------------------------------------------------------------
RESOURCE_MCP_ENABLED=True
RESOURCE_MCP_TIMEOUT_SECONDS=12

# Tavily Search API：用于外部学习资源召回；未配置时自动回退到 LLM 联网推荐
TAVILY_API_KEY=

# -----------------------------------------------------------------------------
# CORS跨域配置
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://edu.qintsg.xyz,http://edu.qintsg.xyz,https://edu.qintsg.cn,http://edu.qintsg.cn,http://127.0.0.1:3000,http://localhost:3000

# -----------------------------------------------------------------------------
# 大模型配置（AI功能）
# 默认全面使用 DeepSeek V4；其它 OpenAI 兼容模型只在代码层显式传入 model_name 时保留。
# .env 只配置统一 OpenAI 兼容网关密钥、可选端点和全局低思考/加速开关。
# -----------------------------------------------------------------------------

# 统一兼容网关 API Key
LLM_API_KEY=your-deepseek-key

# 统一兼容网关基础URL；默认 DeepSeek 官方 OpenAI 兼容端点，可改为企业代理端点。
LLM_BASE_URL=https://api.deepseek.com

# 低思考/加速模式：True 时所有调用都使用 Flash 并关闭思考；False 时按代码内置调用策略选择 Pro/Flash。
LLM_LOW_REASONING_MODE=False

# LLM 请求代理（可选）
# 如果外部模型接口需要走代理，可在此配置；HTTPS 模型网关会优先使用 HTTPS_PROXY / LLM_HTTPS_PROXY。
HTTP_PROXY=
HTTPS_PROXY=
LLM_HTTP_PROXY=
LLM_HTTPS_PROXY=

# -----------------------------------------------------------------------------
# 知识追踪模型配置
# 使用 MEFKT 深度知识追踪模型
# MEFKT 模型代码位于 /models/MEFKT/ 目录
# 训练工具: python tools.py（交互菜单或 train-mefkt 子命令）
# -----------------------------------------------------------------------------

# 预测模式（可选值：single, fusion, ensemble；当前仅启用 MEFKT）
KT_PREDICTION_MODE=single

# 启用的模型列表（逗号分隔）
KT_ENABLED_MODELS=mefkt

# 融合权重（JSON 格式）
KT_FUSION_WEIGHTS='{"mefkt":1.0}'

# MEFKT 模型权重文件路径（可选，留空则自动查找 models/MEFKT/mefkt_model.pt）
KT_MEFKT_MODEL_PATH=models/MEFKT/mefkt_model.pt
KT_MEFKT_META_PATH=models/MEFKT/mefkt_model.meta.json

# 是否使用GPU加速（需要CUDA支持）
KT_USE_GPU=false

# -----------------------------------------------------------------------------
# 课程资源导入配置
# -----------------------------------------------------------------------------
COURSE_RESOURCES_DIR=tools/自适应学习系统-课程资源

# -----------------------------------------------------------------------------
# 日志配置
# -----------------------------------------------------------------------------
# 操作日志保存目录（默认为项目根目录下的logs/operations/）
LOG_DIR=logs/operations

# 是否开启数据库查询日志（调试用，默认关闭）
DEBUG_LOG_DB_QUERIES=False
